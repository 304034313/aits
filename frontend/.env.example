# Pack profile (empty = full edition; llm-eval-api = API-only eval pack)
VITE_AITS_PACK_PROFILE=llm-eval-api

# Sonic 云真机（浏览器直连；开发环境经 Vite 代理避免 CORS）
# 前端请求 baseURL：默认 /sonic-api，由 vite 重写到 Sonic 的 /server/api
VITE_SONIC_API_BASE=/sonic-api
# 开发代理：Sonic Web 控制台地址（与 sonic-client-web dev 默认一致为 3000 端口宿主）
VITE_SONIC_PROXY_TARGET=http://127.0.0.1:3000
# Sonic 自动登录（默认开启；可按需覆盖）
VITE_SONIC_AUTO_LOGIN=true
VITE_SONIC_AUTO_USERNAME=aits-lemon
VITE_SONIC_AUTO_PASSWORD=123456
