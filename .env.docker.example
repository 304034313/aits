# AITS Docker Compose 环境变量（复制为 .env.docker 后修改）
# cp .env.docker.example .env.docker

# Pack profile (empty = full edition; llm-eval-api = API-only eval pack)
AITS_PACK_PROFILE=llm-eval-api
VITE_AITS_PACK_PROFILE=llm-eval-api

# Django
DEBUG=False
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1,backend,nginx

# Redis（compose 服务名）
REDIS_URL=redis://redis:6379/0

# Playwright：容器内默认无界面
AITS_PLAYWRIGHT_HEADLESS=1

# PyTorch 构建变体（docker compose build 时生效，默认 cpu 避免下载 nvidia_* 大包）
# cpu = 默认，知识库 RAG 走 CPU，镜像小、构建快
# gpu = 高级：宿主机需 NVIDIA 驱动，且需自行配置 compose 暴露 GPU
AITS_TORCH_VARIANT=cpu

# Docker 构建国内加速（apt / Playwright Chromium；海外环境可设 AITS_USE_CHINA_MIRROR=0）
AITS_USE_CHINA_MIRROR=1
AITS_APT_MIRROR=mirrors.tuna.tsinghua.edu.cn
PLAYWRIGHT_DOWNLOAD_HOST=https://npmmirror.com/mirrors/playwright

# RAG 嵌入模型（国内镜像）
HF_ENDPOINT=https://hf-mirror.com
EMBEDDING_LOAD_MODE=remote
EMBEDDING_MODEL_REMOTE_NAME=BAAI/bge-large-zh-v1.5

# 可选：Sonic App 测试
SONIC_BASE_URL=
