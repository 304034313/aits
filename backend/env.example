# Pack profile (empty = full edition; llm-eval-api = API-only eval pack)
AITS_PACK_PROFILE=llm-eval-api

# Django Settings
DEBUG=True
DJANGO_SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Settings
# （开发环境使用SQLite）
DATABASE_URL=sqlite:///db.sqlite3
DB_NAME=aits_db
DB_USER=aits_user
DB_PASSWORD=aits_password
DB_HOST=localhost
DB_PORT=5432

# Redis Settings（本地开发默认本机无密码；远程环境请自行修改）
REDIS_URL=redis://localhost:6379/0

# Sonic 云真机（App 测试选修；不做 App 自动化可留空）
# 示例：SONIC_BASE_URL=http://127.0.0.1:3000
SONIC_BASE_URL=
SONIC_API_PREFIX=/server/api
SONIC_TIMEOUT_SECONDS=15
# 登录二选一：账号密码 或 长期 Token
SONIC_USERNAME=
SONIC_PASSWORD=
SONIC_TOKEN=
# 同步用例到 Sonic 时使用的默认项目 ID（与 AITS 项目里的 sonic_project_id 不同概念）
SONIC_PROJECT_ID=0

# File Upload Settings
FILE_UPLOAD_MAX_MEMORY_SIZE=10485760
DATA_UPLOAD_MAX_MEMORY_SIZE=10485760

# PyTorch pip variant for one-click install (set in CMD before 一键安装AITS.bat, default cpu)
# cpu = default, smaller download; gpu|cuda = full CUDA torch from PyPI mirrors
# AITS_TORCH_VARIANT=cpu

# RAG embedding (HuggingFace). Install/start scripts set HF_ENDPOINT by default.
# remote = download via mirror; local = offline folder (see deploy guide)
HF_ENDPOINT=https://hf-mirror.com
EMBEDDING_LOAD_MODE=remote
EMBEDDING_MODEL_REMOTE_NAME=BAAI/bge-large-zh-v1.5
EMBEDDING_MODEL_LOCAL_PATH=

